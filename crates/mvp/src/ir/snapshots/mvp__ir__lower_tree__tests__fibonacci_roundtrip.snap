function fibonacci(_a0) {
  let _t0;
  let _t1;
  let _t2;
  let _t3;
  let _t4;
  let _t5;
  _t0 = (_a0 <= 1);
  if (_t0) {
    return _a0;
  } else {
    _t1 = (_a0 - 1);
    _t2 = fibonacci(_t1);
    _t3 = (_a0 - 2);
