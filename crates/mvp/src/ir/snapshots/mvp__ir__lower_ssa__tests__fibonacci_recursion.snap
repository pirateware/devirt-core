fn @fibonacci(%0["n"]) {
  bb0:                                  ; preds: <none>
    %1 = le %0, 1                       ; may_throw
    cbr %1, bb1, bb2

  bb1:                                  ; preds: bb0
    ret %0

  bb2:                                  ; preds: bb0
    br bb3

  bb3:                                  ; preds: bb2
    %2 = sub_generic %0, 1              ; may_throw
    %3 = call @fibonacci(%2)            ; opaque
    %4 = sub_generic %0, 2              ; may_throw
    %5 = call @fibonacci(%4)            ; opaque
    %6 = add_generic %3, %5             ; may_throw
    ret %6
}
